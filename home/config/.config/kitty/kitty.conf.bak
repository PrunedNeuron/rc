# ══════════════════════════════════════════════════════════════════════════════
# kitty.conf — CachyOS/Arch + Hyprland + Wayland
# Requires kitty ≥ 0.35 (cursor_trail, scrollbar_*, pixel_scroll)
# NOTE: kitty does NOT support inline comments after values.
# Run `kitty +list-shortcuts` to see the full default keybinding set.
# ══════════════════════════════════════════════════════════════════════════════

include themes/noctalia.conf

# ── Single-instance / startup ─────────────────────────────────────────────────
single_instance      yes
instance_group       main
allow_remote_control socket-only
listen_on            unix:@kitty
shell_integration    enabled

# ── Performance ───────────────────────────────────────────────────────────────
input_delay          0
repaint_delay        2
sync_to_monitor      yes
wayland_enable_ime   no
# pacman/paru owns updates on Arch — disable kitty's own polling
update_check_interval 0

# ── Bell ──────────────────────────────────────────────────────────────────────
enable_audio_bell    no
visual_bell_duration 0.0

# ── Font ──────────────────────────────────────────────────────────────────────
font_family      SF Mono Regular
bold_font        SF Mono Bold
italic_font      SF Mono Italic
bold_italic_font SF Mono Bold Italic
font_size        10.0
disable_ligatures never
font_features SF-Mono-Regular +ccmp +c2sc
# Nerd Font symbols without a patched font
symbol_map U+E000-U+E00A,U+EA60-U+EBEB,U+E0A0-U+E0C8,U+E0CA,U+E0CC-U+E0D4,U+E200-U+E2A9,U+E300-U+E3E3,U+E5FA-U+E6B1,U+E700-U+E7C5,U+F000-U+F2E0,U+F300-U+F372,U+F400-U+F532,U+F0001-U+F1AF0 Symbols Nerd Font Mono

# ── Cursor ────────────────────────────────────────────────────────────────────
cursor_shape                 beam
cursor_shape_unfocused       hollow
cursor_blink_interval        0.5
cursor_stop_blinking_after   15.0
cursor_trail                 1
cursor_trail_decay           0.4 0.8
cursor_trail_start_threshold 2

# ── Scrollback ────────────────────────────────────────────────────────────────
scrollback_lines 10000
pixel_scroll     yes

# ── Window ────────────────────────────────────────────────────────────────────
window_padding_width    8
placement_strategy      center
window_border_width     1pt
# active_border_color     #bd93f9
# inactive_border_color   #44475a
# Hyprland manages decorations
hide_window_decorations yes
# Auto-close pane when the child process exits; no zombie panes
close_on_child_death    yes
# Prompt only when the OS window holds multiple kitty windows
confirm_os_window_close -1

# ── Tab bar ───────────────────────────────────────────────────────────────────
tab_bar_edge         bottom
tab_bar_style        powerline
tab_powerline_style  round
tab_title_template   "{fmt.fg.red}{bell_symbol}{activity_symbol}{fmt.fg.tab}{index}: {title}"
tab_bar_min_tabs     1
tab_activity_symbol  "● "

# ── Layouts ───────────────────────────────────────────────────────────────────
enabled_layouts splits,stack,grid,fat,tall,*

# ── Transparency ──────────────────────────────────────────────────────────────
background_opacity         1.0
dynamic_background_opacity yes
text_composition_strategy  platform

# ── URLs & hyperlinks ─────────────────────────────────────────────────────────
url_style              straight
open_url_with          default
show_hyperlink_targets yes
detect_urls            yes
allow_hyperlinks       yes

# ── Clipboard ─────────────────────────────────────────────────────────────────
copy_on_select    clipboard
clipboard_control write-clipboard write-primary read-clipboard-ask read-primary-ask

# ── Notifications ─────────────────────────────────────────────────────────────
notify_on_cmd_finish unfocused 10.0

# ── Mouse ─────────────────────────────────────────────────────────────────────
mouse_hide_wait     3.0
focus_follows_mouse yes

# ── Scrollbar ─────────────────────────────────────────────────────────────────
scrollbar_width       0.3
scrollbar_hover_width 0.6
scrollbar_gap         0.75
touch_scroll_multiplier 3.0

# ── Wayland ───────────────────────────────────────────────────────────────────
linux_display_server   wayland
# wayland_titlebar_color system

# ══════════════════════════════════════════════════════════════════════════════
# KEY MAPPINGS
#
# kitty_mod = ctrl+shift.
# NEVER write `kitty_mod+shift` — that expands to ctrl+shift+shift, a dead combo.
# Secondary/variant bindings use `kitty_mod+alt` (= ctrl+shift+alt).
#
# Only non-default bindings are declared here. Defaults intentionally kept:
#   copy/paste, scrolling, scroll_to_prompt (z/x), show_scrollback (h),
#   show_last_cmd_output (g), close_window (w), close_tab (q), fullscreen (f11),
#   unicode_input (u), open_url (e), edit/reload/debug config (f2/f5/f6),
#   kitty_shell (escape), show_kitty_doc (f1), visually_swap_window (f8),
#   set_tab_title (alt+t), clear scrollback (delete), move_window_to_top (`)
# ══════════════════════════════════════════════════════════════════════════════

kitty_mod ctrl+shift

# ── Shell fix ─────────────────────────────────────────────────────────────────
# ZSH/readline backward-kill-word expects ^H (0x08).
# kitty's full keyboard protocol would otherwise emit ^[[127;5u.
map ctrl+backspace send_text all \x08

# ── Windows — open at cwd (override defaults that open at $HOME) ──────────────
map kitty_mod+enter  new_window_with_cwd
map kitty_mod+n      new_os_window_with_cwd

# ── Splits ────────────────────────────────────────────────────────────────────
map kitty_mod+backslash     launch --location=vsplit --cwd=current
map kitty_mod+alt+backslash launch --location=hsplit --cwd=current
map kitty_mod+r             layout_action rotate

# ── Focus navigation (vim-style; no kitty defaults for these) ─────────────────
map kitty_mod+h neighboring_window left
map kitty_mod+l neighboring_window right
map kitty_mod+k neighboring_window up
map kitty_mod+j neighboring_window down

# ── Window movement — directional (no kitty defaults for these) ───────────────
map kitty_mod+alt+h move_window left
map kitty_mod+alt+l move_window right
map kitty_mod+alt+k move_window up
map kitty_mod+alt+j move_window down

# ── Visual window focus picker ────────────────────────────────────────────────
# Overrides move_window_forward at kitty_mod+f with the more useful picker.
# visually_swap_window retains its default at kitty_mod+f8.
map kitty_mod+f visually_focus_window

# ── Resize ────────────────────────────────────────────────────────────────────
# alt+arrows avoids clobbering scroll-line defaults at plain kitty_mod+arrows.
map kitty_mod+alt+left  resize_window narrower 3
map kitty_mod+alt+right resize_window wider    3
map kitty_mod+alt+up    resize_window taller   3
map kitty_mod+alt+down  resize_window shorter  3
map kitty_mod+alt+home  resize_window reset

# ── Font size (1 pt steps; kitty defaults use 2 pt) ──────────────────────────
map kitty_mod+equal change_font_size all +1.0
map kitty_mod+minus change_font_size all -1.0
# Alias — default reset is kitty_mod+backspace; this adds a more intuitive key
map kitty_mod+0     change_font_size all 0

# ── Tabs ──────────────────────────────────────────────────────────────────────
# new_tab_with_cwd overrides the default new_tab (which opens at $HOME)
map kitty_mod+t     new_tab_with_cwd
# ./comma for next/prev repurpose the defaults (move_tab_forward/backward);
# alt variants restore move_tab functionality
map kitty_mod+.         next_tab
map kitty_mod+comma     previous_tab
map kitty_mod+alt+.     move_tab_forward
map kitty_mod+alt+comma move_tab_backward
# goto_tab has no kitty defaults
map kitty_mod+1 goto_tab 1
map kitty_mod+2 goto_tab 2
map kitty_mod+3 goto_tab 3
map kitty_mod+4 goto_tab 4
map kitty_mod+5 goto_tab 5
map kitty_mod+6 goto_tab 6
map kitty_mod+7 goto_tab 7
map kitty_mod+8 goto_tab 8
map kitty_mod+9 goto_tab 9

# ── Layouts ───────────────────────────────────────────────────────────────────
# kitty_mod+s has no default — safe to assign directly
map kitty_mod+s     toggle_layout splits
# alt variants avoid clobbering:
#   kitty_mod+z → scroll_to_prompt -1  (default, needs shell_integration)
#   kitty_mod+g → show_last_cmd_output (default, needs shell_integration)
map kitty_mod+alt+z toggle_layout stack
map kitty_mod+alt+g toggle_layout grid
map kitty_mod+alt+f goto_layout fat
map kitty_mod+alt+v goto_layout tall

# ── Hints ─────────────────────────────────────────────────────────────────────
# open_url_with_hints at kitty_mod+e is already the default; these extend it
map kitty_mod+o     kitten hints --type path       --program @
map kitty_mod+y     kitten hints --type hash       --program @
map kitty_mod+i     kitten hints --type ip_address --program @
map kitty_mod+alt+w kitten hints --type word       --program @
map kitty_mod+alt+l kitten hints --type line       --program @

# ── Background opacity (leader: kitty_mod+a > key) ────────────────────────────
map kitty_mod+a>m set_background_opacity +0.05
map kitty_mod+a>l set_background_opacity -0.05
map kitty_mod+a>1 set_background_opacity 1.0
map kitty_mod+a>d set_background_opacity default

# ── Clear to prompt (complement to default full-wipe at kitty_mod+delete) ─────
# Requires shell_integration enabled
map kitty_mod+alt+delete clear_terminal to_cursor active

# ── Live theme switcher overlay ───────────────────────────────────────────────
map kitty_mod+F3 launch --type=overlay kitty +kitten themes
