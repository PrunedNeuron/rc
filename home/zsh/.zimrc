# ~/.zimrc — zimfw module manifest.
#
# After changes:
#   zimfw install
#   zimfw compile
#   exec zsh
#
# Ordering invariants:
# • zsh-defer first.
# • Completion-definition providers before Zim's completion module.
# • Zim completion runs compinit.
# • fzf-tab AFTER completion/compinit.
# • fzf-tab BEFORE later ZLE-wrapping interactive plugins.
# • autosuggestions-abbreviations-strategy after both zsh-abbr and
#   zsh-autosuggestions.

# ══════════════════════════════════════════════════════════════════════════════
# Foundation
# ══════════════════════════════════════════════════════════════════════════════

zmodule romkatv/zsh-defer

zmodule environment
zmodule termtitle
zmodule pacman


# ══════════════════════════════════════════════════════════════════════════════
# Productivity
# ══════════════════════════════════════════════════════════════════════════════

zmodule archive
zmodule git
zmodule robertzk/send.zsh
zmodule wfxr/forgit
zmodule junegunn/fzf-git.sh --source fzf-git.sh
zmodule ohmyzsh/ohmyzsh --root plugins/systemd


# ══════════════════════════════════════════════════════════════════════════════
# Shell UX
# ══════════════════════════════════════════════════════════════════════════════

zmodule ohmyzsh/ohmyzsh --root plugins/eza
zmodule ohmyzsh/ohmyzsh --root plugins/colored-man-pages
zmodule ohmyzsh/ohmyzsh --root plugins/command-not-found


# ══════════════════════════════════════════════════════════════════════════════
# Quality of life
# ══════════════════════════════════════════════════════════════════════════════

zmodule hlissner/zsh-autopair
zmodule olets/zsh-abbr
zmodule Tarrasch/zsh-bd
zmodule jirutka/zsh-shift-select

# Optional; useful but potentially noisy.
# zmodule MichaelAquilina/zsh-you-should-use


# ══════════════════════════════════════════════════════════════════════════════
# Completion pipeline
# ══════════════════════════════════════════════════════════════════════════════

# Completion definitions must be on fpath before compinit.
zmodule zsh-users/zsh-completions --fpath src

# fzf shell integration.
zmodule fzf

# Runs compinit.
zmodule completion

# Must load after compinit.
#
# Intentionally pinned while avoiding the newer fzf-tab completion regression
# affecting this setup.
zmodule Aloxaf/fzf-tab --tag v1.1.2


# ══════════════════════════════════════════════════════════════════════════════
# Interactive enhancements
# ══════════════════════════════════════════════════════════════════════════════

zmodule zsh-users/zsh-syntax-highlighting
zmodule zsh-users/zsh-history-substring-search
zmodule zsh-users/zsh-autosuggestions

# Requires both zsh-abbr and zsh-autosuggestions.
zmodule olets/zsh-autosuggestions-abbreviations-strategy
