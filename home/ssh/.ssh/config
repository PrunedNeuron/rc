# ~/.ssh/config
# Client SSH Configuration

Include conf.d/*

Host *
    # Authentication
    PubkeyAuthentication yes
    PasswordAuthentication no          # deny by default; re-enabled per-host below where required
    KbdInteractiveAuthentication no

    # Trust OpenSSH's maintained crypto defaults (already ML-KEM-first for
    # KEX, already excludes SHA-1 host keys) — just strip two legacy MAC
    # fallbacks that remain in the default set for backward compatibility
    MACs -*sha1*,umac-64*

    # Never forward credentials or GUI sessions implicitly
    ForwardAgent no
    ForwardX11 no

    # Host-key hygiene
    HashKnownHosts yes
    UpdateHostKeys yes

    # Connection robustness
    ConnectTimeout 15
    ServerAliveInterval 30
    ServerAliveCountMax 3

    # Multiplexing — authenticate once per host, persist until reboot/shutdown
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist yes

    # Agent
    AddKeysToAgent yes

    ## 1Password SSH Agent
    IdentityAgent ~/.1password/agent.sock
