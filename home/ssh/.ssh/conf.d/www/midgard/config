# ~/.ssh/conf.d/www/midgard/config
# SSH configuration for Midgard (Hosts not administered by me)

# -> envs.net (~verse)
Host envs
    HostName envs.net
    User ayush
    IdentityFile ~/.ssh/keys/www/midgard/id_ed25519_envs_net
    IdentitiesOnly yes

# -> thunix.net (~verse)
Host thunix
    HostName thunix.net
    User ayush
    IdentityFile ~/.ssh/keys/www/midgard/id_ed25519_thunix
    IdentitiesOnly yes

# -> tilde.club (~verse)
Host tilde
    HostName tilde.club
    User ayush
    IdentityFile ~/.ssh/keys/www/midgard/id_ed25519_tilde_club
    IdentitiesOnly yes
