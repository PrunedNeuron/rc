# ~/.ssh/conf.d/vcs/config
# SSH Configuration for VCS service providers

# -> GitHub (via port 443 — bypasses networks that block port 22)
Host github.com
    HostName ssh.github.com
    Port 443
    User git
    IdentityFile ~/.ssh/keys/vcs/id_ed25519_github
    IdentitiesOnly yes

# -> Bitbucket
Host bitbucket.org
    HostName bitbucket.org
    User git
    IdentityFile ~/.ssh/keys/vcs/id_ed25519_bitbucket
    IdentitiesOnly yes

# -> GitLab
Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/keys/vcs/id_ed25519_gitlab
    IdentitiesOnly yes

# -> Codeberg
Host codeberg.org
    HostName codeberg.org
    User git
    IdentityFile ~/.ssh/keys/vcs/id_ed25519_codeberg
    IdentitiesOnly yes
