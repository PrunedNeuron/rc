alias nvimconf='"${EDITOR}" "${XDG_CONFIG_HOME:-$HOME/.config}/nvim/"'
alias zshrc='"${EDITOR}" "$HOME/.zshrc"'
alias zshenv='"${EDITOR}" "$HOME/.zshenv"'
alias zprofile='"${EDITOR}" "$HOME/.zprofile"'
alias zimrc='"${EDITOR}" "$HOME/.zimrc"'
alias zshalias='"${EDITOR}" "${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliases.zsh"'
alias starshiprc='starship config'
alias hyprconf='"${EDITOR}" "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf"'
alias kittyconf='"${EDITOR}" "${XDG_CONFIG_HOME:-$HOME/.config}/kitty/kitty.conf"'
alias yayrc='"${EDITOR}" "${XDG_CONFIG_HOME:-$HOME/.config}/yay/config.json"'
alias foxrc='"${EDITOR}" "$HOME/.mozilla/firefox/nightly/user.js"'
alias sshconf='"${EDITOR}" "$HOME/.ssh/config"'
alias gitconf='"${EDITOR}" "${XDG_CONFIG_HOME:-$HOME/.config}/git/config"'

# ══════════════════════════════════════════════════════════════════════════════
# 14 — Root config file shortcuts (sudoedit — safe, uses $SUDO_EDITOR)
# ══════════════════════════════════════════════════════════════════════════════

alias pacmanrc='sudo -e /etc/pacman.conf'
alias makepkgrc='sudo -e /etc/makepkg.conf'
alias dnscryptrc='sudo -e /etc/dnscrypt-proxy/dnscrypt-proxy.toml'
alias resolvrc='sudo -e /etc/resolv.conf'
alias hostsrc='sudo -e /etc/hosts'
alias nginxrc='sudo -e /etc/nginx/nginx.conf'
alias ftlrc='sudo -e /etc/pihole/pihole-FTL.conf'
alias piholerc='sudo -e /etc/pihole/pihole-FTL.conf'
